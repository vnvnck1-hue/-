; Engine configuration file.
config_version=5

[application]

config/name="Trio Chess"
config/description="Trio Chess - Toy Clash style 3-hero grid defense"
run/main_scene="res://scenes/Lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

Music="*res://scripts/music.gd"
WebLookHook="*res://scripts/web_look.gd"
ShaderWarmup="*res://scripts/shader_warmup.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font.web="res://fonts/noto_kr_web.tres"

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
